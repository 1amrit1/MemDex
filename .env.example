# MemDex settings. Copy to .env (git-ignored) and edit.
# Precedence: real environment variables > .env > memdex.yaml > built-in defaults.
# Relative paths resolve against the folder of memdex.yaml (or the current folder when there is no memdex.yaml).

# Sources and collection routing live in this YAML file (optional - projects created in the UI need no YAML)
MEMDEX_CONFIG=memdex.yaml

# Vector store - keep it OUT of OneDrive/Dropbox (sync + live DB files = locks/corruption)
MEMDEX_INDEX_DIR=.index

# Embedding model folder, filled once by `memdex fetch-model`
MEMDEX_MODEL_DIR=models

# Data folder: data/sources/<project>/ (uploads from the UI), data/logs/queries.jsonl, data/eval/
MEMDEX_DATA_DIR=data

# Max characters per chunk. all-MiniLM-L6-v2 reads 256 tokens; 700 keeps truncation near 0 for Markdown
MEMDEX_MAX_CHARS=700
